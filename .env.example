# Generic/local configuration template. Production Coolify supplies runtime-only
# protected values and one managed Gateway domain; choose that domain in the CLI/UI.
DEPLOYMENT_ENVIRONMENT=development
TZ=UTC

MCP_PUBLIC_BASE_URL=https://mcp.example.test
CONTROL_PANEL_PUBLIC_BASE_URL=https://mcp.example.test
MCP_ALLOWED_HOSTS=mcp.example.test
MCP_ALLOWED_ORIGINS=https://mcp.example.test

# External ZITADEL issuer, project/organization and public browser client.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_PANEL_CLIENT_ID=

# Required endpoints of the already deployed external Ghidra MCP.
# Supply its actual reachable MCP and direct artifact upload URLs.
GHIDRA_MCP_URL=
GHIDRA_DIRECT_UPLOAD_URL=

# Required protected runtime credentials. Never place real values in Git.
BRIAREUS_SERVICE_TOKEN=
CONTROL_PANEL_ENCRYPTION_KEY=
BROWSER_CONTROL_TOKEN=
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=briareus
POSTGRES_PASSWORD=
VALKEY_USERNAME=default
VALKEY_PASSWORD=

# Optional isolated local launcher/identity fixture state.
# Production Coolify does not consume this local path.
BRIAREUS_LOCAL_STATE_DIR=

# Optional remote telemetry. Instrumented services set their own service name.
OTEL_NAMESPACE=briareus
OTEL_ENDPOINT=
OTEL_BEARER_TOKEN=

# Optional browser telemetry forwarder. Disabled when no endpoint is supplied.
CONTROL_PANEL_FRONTEND_TELEMETRY_UPSTREAM_URL=
CONTROL_PANEL_FRONTEND_TELEMETRY_BEARER_TOKEN=

# Shared container mount for Server, Git providers, Web downloads and API files.
SERVER_MOUNT_PATH=/workspace

# OIDC provider role mapping; JSON array of literal path segments.
OIDC_SCOPES=openid,profile,email,offline_access
OIDC_ROLES_CLAIM_PATH=["roles"]
OIDC_ROLES_FORMAT=list
OIDC_REQUIRED_ROLE=access
OIDC_ROLES_ORGANIZATION_ID=
OIDC_JWT_ALGORITHMS=RS256
