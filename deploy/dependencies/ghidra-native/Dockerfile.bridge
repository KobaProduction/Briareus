FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS ghidra-source
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY deploy/dependencies/ghidra-native/source.json /source.json
COPY deploy/dependencies/ghidra-native/fetch_source.py /fetch_source.py
RUN python /fetch_source.py

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app

COPY --from=ghidra-source /vendor/pyproject.toml /vendor/uv.lock /vendor/README.md /vendor/LICENSE ./
COPY --from=ghidra-source /vendor/python ./python

RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8081

CMD ["bridge-mcp-ghidra", "--transport", "streamable-http", "--mcp-host", "0.0.0.0", "--mcp-port", "8081", "--no-lazy"]
