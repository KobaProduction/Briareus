{
  "name": "@briareus/control-panel-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "vite --mode local-testing --host 127.0.0.1 --port 80 --strictPort",
    "build": "vue-tsc --noEmit && vite build && bun run scripts/prerender-site.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test tests",
    "lint": "biome lint --error-on-warnings .",
    "lint:architecture": "bun --bun ./node_modules/steiger/dist/cli.mjs src --fail-on-warnings",
    "format:check": "biome format .",
    "quality": "python ../../scripts/quality_gate.py",
    "quality:all": "python ../../scripts/quality_gate.py --all",
    "typecheck:all": "vue-tsc --noEmit --project tsconfig.quality.json"
  },
  "dependencies": {
    "@tanstack/vue-table": "9.2.4",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "0.545.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.22",
    "vue-i18n": "11.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/vite": "4.1.14",
    "@types/bun": "1.4.3",
    "@vitejs/plugin-vue": "6.0.0",
    "steiger": "0.8.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2",
    "vite": "8.0.0",
    "vue-tsc": "3.0.7"
  }
}
